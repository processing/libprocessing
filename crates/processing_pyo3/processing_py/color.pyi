from mewnala.math import PyVecIter, Vec3, Vec4
from typing import final

@final
class Color:
    def __eq__(self, /, other: object) -> bool: ...
    def __getitem__(self, /, idx: int) -> float: ...
    def __hash__(self, /) -> int: ...
    def __iter__(self, /) -> PyVecIter: ...
    def __len__(self, /) -> int: ...
    def __new__(cls, /, *args) -> Color: ...
    def __repr__(self, /) -> str: ...
    def __str__(self, /) -> str: ...
    @property
    def a(self, /) -> float: ...
    @a.setter
    def a(self, /, val: float) -> None: ...
    @property
    def b(self, /) -> float: ...
    @b.setter
    def b(self, /, val: float) -> None: ...
    def darker(self, /, amount: float) -> Color: ...
    def distance(self, /, other: Color) -> float: ...
    def distance_squared(self, /, other: Color) -> float: ...
    @property
    def g(self, /) -> float: ...
    @g.setter
    def g(self, /, val: float) -> None: ...
    @staticmethod
    def gray(lightness: float) -> Color: ...
    @staticmethod
    def hex(s: str) -> Color: ...
    @staticmethod
    def hsla(h: float, s: float, l: float, a: float = 1.0) -> Color: ...
    @staticmethod
    def hsva(h: float, s: float, v: float, a: float = 1.0) -> Color: ...
    def hue(self, /) -> float: ...
    @staticmethod
    def hwba(h: float, w: float, b: float, a: float = 1.0) -> Color: ...
    def is_fully_opaque(self, /) -> bool: ...
    def is_fully_transparent(self, /) -> bool: ...
    @staticmethod
    def lab(l: float, a_axis: float, b_axis: float, alpha: float = 1.0) -> Color: ...
    @staticmethod
    def lch(l: float, c: float, h: float, a: float = 1.0) -> Color: ...
    def lerp(self, /, other: Color, t: float) -> Color: ...
    def lighter(self, /, amount: float) -> Color: ...
    @staticmethod
    def linear(r: float, g: float, b: float, a: float = 1.0) -> Color: ...
    def luminance(self, /) -> float: ...
    def mix(self, /, other: Color, t: float) -> Color: ...
    @staticmethod
    def oklab(l: float, a_axis: float, b_axis: float, alpha: float = 1.0) -> Color: ...
    @staticmethod
    def oklch(l: float, c: float, h: float, a: float = 1.0) -> Color: ...
    @property
    def r(self, /) -> float: ...
    @r.setter
    def r(self, /, val: float) -> None: ...
    def rotate_hue(self, /, degrees: float) -> Color: ...
    def saturation(self, /) -> float: ...
    @staticmethod
    def srgb(r: float, g: float, b: float, a: float = 1.0) -> Color: ...
    def to_hex(self, /) -> str: ...
    def to_hsla(self, /) -> Color: ...
    def to_hsva(self, /) -> Color: ...
    def to_hwba(self, /) -> Color: ...
    def to_lab(self, /) -> Color: ...
    def to_lch(self, /) -> Color: ...
    def to_linear(self, /) -> Color: ...
    def to_list(self, /) -> list[float]: ...
    def to_oklab(self, /) -> Color: ...
    def to_oklch(self, /) -> Color: ...
    def to_srgba(self, /) -> Color: ...
    def to_tuple(self, /) -> tuple: ...
    def to_vec3(self, /) -> Vec3: ...
    def to_vec4(self, /) -> Vec4: ...
    def to_xyz(self, /) -> Color: ...
    def with_alpha(self, /, a: float) -> Color: ...
    def with_hue(self, /, hue: float) -> Color: ...
    def with_luminance(self, /, value: float) -> Color: ...
    def with_saturation(self, /, saturation: float) -> Color: ...
    @staticmethod
    def xyz(x: float, y: float, z: float, a: float = 1.0) -> Color: ...

def hex(s: str) -> Color: ...
def hsla(h: float, s: float, l: float, a: float = 1.0) -> Color: ...
def hsva(h: float, s: float, v: float, a: float = 1.0) -> Color: ...
def hwba(h: float, w: float, b: float, a: float = 1.0) -> Color: ...
def lab(l: float, a_axis: float, b_axis: float, alpha: float = 1.0) -> Color: ...
def lch(l: float, c: float, h: float, a: float = 1.0) -> Color: ...
def linear(r: float, g: float, b: float, a: float = 1.0) -> Color: ...
def oklab(l: float, a_axis: float, b_axis: float, alpha: float = 1.0) -> Color: ...
def oklch(l: float, c: float, h: float, a: float = 1.0) -> Color: ...
def srgb(r: float, g: float, b: float, a: float = 1.0) -> Color: ...
def xyz(x: float, y: float, z: float, a: float = 1.0) -> Color: ...
